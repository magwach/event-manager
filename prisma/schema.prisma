// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  Tech
  Sports
  Academic
  Social
}

model User {
  id           String   @id @default(cuid())
  clerkId      String   @unique
  email        String   @unique
  firstName    String?
  lastName     String?
  phone        String?
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookedEvents BookedEvents[]

  @@map("users")
}

model Event {
  id                String         @id @default(cuid())
  title             String         @unique
  description       String         @unique
  fullDescription   String         @unique
  date              DateTime
  category          Category
  location          String
  organizer         String
  image             String
  time              DateTime
  duration          Int
  price             Int
  capacity          Int
  remainingCapacity Int
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  bookedEvents      BookedEvents[]

  @@map("events")
}

model BookedEvents {
  id           String   @id @default(cuid())
  userId       String
  eventId      String
  paymentId    String
  reciptNumber String
  reciept      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("booked_events")
}
